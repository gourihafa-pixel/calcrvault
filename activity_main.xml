<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101010">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="end|center_vertical"
        android:padding="24dp"
        android:textSize="42sp"
        android:textColor="#FFFFFF"
        android:text="0" />

    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:padding="8dp">

        <Button android:id="@+id/btnClear" android:text="C" style="@style/CalcBtnFunc"
            app:layout_column="0" app:layout_row="0" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btnDel" android:text="⌫" style="@style/CalcBtnFunc"
            app:layout_column="1" app:layout_row="0" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btnDiv" android:text="÷" style="@style/CalcBtnOp"
            app:layout_column="2" app:layout_row="0" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btnMul" android:text="×" style="@style/CalcBtnOp"
            app:layout_column="3" app:layout_row="0" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>

        <Button android:id="@+id/btn7" android:text="7" style="@style/CalcBtnNum"
            app:layout_column="0" app:layout_row="1" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btn8" android:text="8" style="@style/CalcBtnNum"
            app:layout_column="1" app:layout_row="1" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btn9" android:text="9" style="@style/CalcBtnNum"
            app:layout_column="2" app:layout_row="1" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btnMinus" android:text="-" style="@style/CalcBtnOp"
            app:layout_column="3" app:layout_row="1" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>

        <Button android:id="@+id/btn4" android:text="4" style="@style/CalcBtnNum"
            app:layout_column="0" app:layout_row="2" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btn5" android:text="5" style="@style/CalcBtnNum"
            app:layout_column="1" app:layout_row="2" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btn6" android:text="6" style="@style/CalcBtnNum"
            app:layout_column="2" app:layout_row="2" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btnPlus" android:text="+" style="@style/CalcBtnOp"
            app:layout_column="3" app:layout_row="2" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>

        <Button android:id="@+id/btn1" android:text="1" style="@style/CalcBtnNum"
            app:layout_column="0" app:layout_row="3" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btn2" android:text="2" style="@style/CalcBtnNum"
            app:layout_column="1" app:layout_row="3" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btn3" android:text="3" style="@style/CalcBtnNum"
            app:layout_column="2" app:layout_row="3" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btnEq" android:text="=" style="@style/CalcBtnEq"
            app:layout_rowSpan="2" app:layout_row="3"
            app:layout_column="3" app:layout_columnWeight="1"
            app:layout_gravity="fill"
            app:layout_rowWeight="1"/>

        <Button android:id="@+id/btn0" android:text="0" style="@style/CalcBtnNum"
            app:layout_column="0" app:layout_row="4" app:layout_columnSpan="2"
            app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
        <Button android:id="@+id/btnDot" android:text="." style="@style/CalcBtnNum"
            app:layout_column="2" app:layout_row="4" app:layout_columnWeight="1" app:layout_rowWeight="1"
            app:layout_gravity="fill"/>
    </androidx.gridlayout.widget.GridLayout>
</LinearLayout>
